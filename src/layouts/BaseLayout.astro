---
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@/styles/globals.css";

import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

import { ScrollTop } from "@/components/scroll-top";
import { SiteFooter } from "@/components/site-footer";
import { SiteHeader } from "@/components/site-header";
import { collapsibleScript } from "@/components/ui/collapsible";
import { META_THEME_COLORS, SITE_INFO } from "@/config/site";
import { USER } from "@/data/user";
import { buildTitle } from "@/lib/seo";
import {
  absoluteUrl,
  getSiteGraphJsonLd,
  toJsonLd,
} from "@/lib/structured-data";

export interface Props {
  title?: string;
  /** Use exactly this <title> (skip the suffix logic). */
  fullTitle?: string;
  description?: string;
  /** Site-relative canonical path, e.g. "/blog/welcome". */
  canonical: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article" | "profile";
  ogTitle?: string;
  article?: {
    publishedTime: Date | string;
    modifiedTime?: Date | string;
    section?: string;
    tags?: string[];
  };
  /** text/markdown twin of this page. */
  markdownPath?: string;
  jsonLd?: object[];
  /** Extra <meta name> tags (e.g. Highwire citation_* for Google Scholar). */
  meta?: Record<string, string | string[]>;
  noindex?: boolean;
}

const {
  title,
  fullTitle,
  description = SITE_INFO.description,
  canonical,
  ogImage = SITE_INFO.ogImage,
  ogImageAlt = SITE_INFO.name,
  ogType = "website",
  ogTitle,
  article,
  markdownPath,
  jsonLd = [],
  meta = {},
  noindex = false,
} = Astro.props;

const pageTitle = fullTitle ?? buildTitle(title);
const canonicalUrl =
  absoluteUrl(canonical === "/" ? "" : canonical) || SITE_INFO.url;
const ogImageUrl = absoluteUrl(ogImage);
const iso = (d: Date | string) => new Date(d).toISOString();
// build.format "file" reports the home page as "/index".
const pathname =
  Astro.url.pathname.replace(/\.html$/, "").replace(/(\/index)?\/?$/, "") ||
  "/";

// Thanks @shadcn-ui, @tailwindcss. Applies the theme before first paint.
const themeScript = `
(() => {
  try {
    const t = localStorage.getItem('theme');
    const dark = t === 'dark' || ((!t || t === 'system') && matchMedia('(prefers-color-scheme: dark)').matches);
    const root = document.documentElement;
    root.classList.add(dark ? 'dark' : 'light');
    root.style.colorScheme = dark ? 'dark' : 'light';
    if (dark) document.querySelector('meta[name="theme-color"]').setAttribute('content', '${META_THEME_COLORS.dark}');
  } catch (_) {}
  try {
    if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) document.documentElement.classList.add('os-macos');
  } catch (_) {}
})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content={META_THEME_COLORS.light} />
    <script is:inline set:html={themeScript} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content={USER.displayName} />
    <meta name="creator" content={USER.username} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_INFO.name} – Blog`}
      href={absoluteUrl("/rss")}
    />
    {markdownPath && (
      <link
        rel="alternate"
        type="text/markdown"
        href={absoluteUrl(markdownPath)}
      />
    )}

    <meta property="og:site_name" content={SITE_INFO.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === "profile" && (
      <>
        <meta property="profile:first_name" content={USER.firstName} />
        <meta property="profile:last_name" content={USER.lastName} />
        <meta property="profile:username" content={USER.username} />
      </>
    )}
    {article && (
      <>
        <meta
          property="article:published_time"
          content={iso(article.publishedTime)}
        />
        {article.modifiedTime && (
          <meta
            property="article:modified_time"
            content={iso(article.modifiedTime)}
          />
        )}
        <meta property="article:author" content={absoluteUrl("/")} />
        {article.section && (
          <meta property="article:section" content={article.section} />
        )}
        {article.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@APrashun" />
    <meta name="twitter:title" content={ogTitle ?? pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {Object.entries(meta).flatMap(([name, value]) =>
      (Array.isArray(value) ? value : [value]).map((content) => (
        <meta name={name} content={content} />
      ))
    )}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <script
      type="application/ld+json"
      set:html={toJsonLd(getSiteGraphJsonLd())}
    />
    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={toJsonLd(data)} />
    ))}
    <slot name="head" />
  </head>

  <body>
    <SiteHeader client:idle pathname={pathname} />
    <main class="max-w-screen overflow-x-hidden px-2">
      <slot />
    </main>
    <SiteFooter />
    <ScrollTop client:idle />
    <script is:inline set:html={collapsibleScript} />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
